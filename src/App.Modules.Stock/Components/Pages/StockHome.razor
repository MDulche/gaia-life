@page "/stock"
@* Tableau des articles en stock + infos / inventaire séparés. *@
@* Mobile (MAUI) : pas d'Identity — [Authorize] retiré (contrat mono-utilisateur). *@
@inject StockService Stock
@inject IActiveModuleGuard ModuleGuard
@inject NavigationManager Navigation

<PageTitle>Stock</PageTitle>

<h1 class="h3 mb-3">Stock</h1>

<p class="mb-3">
    <a href="/stock/parametres" class="btn btn-outline-secondary btn-sm">Catégories &amp; admin</a>
</p>

@if (!_ready)
{
    <p class="text-muted">Chargement…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_info))
    {
        <div class="alert alert-info" role="alert">@_info</div>
    }

    @if (_fusionProposee is { } fusion)
    {
        <div class="alert alert-warning" role="alert">
            <p class="mb-2">@fusion.Message</p>
            <button type="button" class="btn btn-warning btn-sm me-2" disabled="@_busy" @onclick="ConfirmerFusionAsync">Fusionner</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="AnnulerFusion">Annuler</button>
        </div>
    }

    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Quantité</th>
                    <th>Unité</th>
                    <th>Catégorie</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_articles.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center">Aucun article en stock pour le moment.</td>
                    </tr>
                }
                else
                {
                    @foreach (var article in _articles)
                    {
                        <tr>
                            @if (_editId == article.Id)
                            {
                                <td><InputText class="form-control form-control-sm" @bind-Value="_editNom" /></td>
                                <td>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_editQuantite" title="Inventaire (mouvement)" />
                                    <div class="form-text">Inventaire</div>
                                </td>
                                <td><InputText class="form-control form-control-sm" @bind-Value="_editUnite" /></td>
                                <td>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_editCategorieId">
                                        @foreach (var cat in _categories)
                                        {
                                            <option value="@cat.Id">@cat.Nom</option>
                                        }
                                    </InputSelect>
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_editSeuil" placeholder="Seuil" />
                                </td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveEditAsync">Enregistrer</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Annuler</button>
                                </td>
                            }
                            else
                            {
                                <td>@article.Nom</td>
                                <td>@article.Quantite.ToString("0.###")</td>
                                <td>@(article.Unite ?? "—")</td>
                                <td>@(article.Categorie?.Nom ?? "—")</td>
                                <td>
                                    @if (StockService.EstStockBas(article))
                                    {
                                        <span class="badge text-bg-warning">Stock bas</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">OK</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => StartEdit(article)">Modifier</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="() => DeleteAsync(article.Id)">Supprimer</button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 class="h6">Ajouter un article</h2>
    @if (_categories.Count == 0)
    {
        <p class="text-muted">Créez d'abord une catégorie dans <a href="/stock/parametres">les paramètres Stock</a>.</p>
    }
    else
    {
        <EditForm Model="_nouveau" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="stock-nom">Nom</label>
                    <InputText id="stock-nom" class="form-control form-control-sm" @bind-Value="_nouveau.Nom" />
                    <ValidationMessage For="() => _nouveau.Nom" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="stock-qte">Quantité</label>
                    <InputNumber id="stock-qte" class="form-control form-control-sm" @bind-Value="_nouveau.Quantite" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="stock-unite">Unité</label>
                    <InputText id="stock-unite" class="form-control form-control-sm" @bind-Value="_nouveau.Unite" placeholder="kg, unité…" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="stock-seuil">Seuil alerte</label>
                    <InputNumber id="stock-seuil" class="form-control form-control-sm" @bind-Value="_nouveau.SeuilAlerte" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="stock-cat">Catégorie</label>
                    <InputSelect id="stock-cat" class="form-select form-select-sm" @bind-Value="_nouveau.CategorieId">
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@cat.Nom</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@_busy">Ajouter</button>
                </div>
            </div>
        </EditForm>
    }
}

@code {
    private bool _ready;
    private bool _busy;
    private string? _error;
    private string? _info;
    private List<ArticleStock> _articles = [];
    private List<Categorie> _categories = [];
    private ArticleForm _nouveau = new();
    private int? _editId;
    private string _editNom = string.Empty;
    private decimal _editQuantite;
    private decimal _editQuantiteInitiale;
    private string? _editUnite;
    private decimal? _editSeuil;
    private int _editCategorieId;
    private AjoutArticleResultat? _fusionProposee;
    private ArticleForm? _fusionPending;

    protected override async Task OnInitializedAsync()
    {
        if (!await StockAccess.EnsureActiveAsync(ModuleGuard, Navigation))
        {
            return;
        }

        await ReloadAsync();
        _ready = true;
    }

    private async Task ReloadAsync()
    {
        _articles = await Stock.ListerArticlesAsync();
        _categories = await Stock.ListerCategoriesAsync();
        if (_nouveau.CategorieId == 0 && _categories.Count > 0)
        {
            _nouveau.CategorieId = _categories[0].Id;
        }
    }

    private void StartEdit(ArticleStock article)
    {
        _editId = article.Id;
        _editNom = article.Nom;
        _editQuantite = article.Quantite;
        _editQuantiteInitiale = article.Quantite;
        _editUnite = article.Unite;
        _editSeuil = article.SeuilAlerte;
        _editCategorieId = article.CategorieId;
        _error = null;
        _info = null;
    }

    private void CancelEdit() => _editId = null;

    private async Task SaveEditAsync()
    {
        if (_editId is not int id)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Stock.ModifierInfosArticleAsync(id, _editNom, _editUnite, _editSeuil, _editCategorieId);
            if (_editQuantite != _editQuantiteInitiale)
            {
                await Stock.DefinirQuantiteInventaireAsync(id, _editQuantite);
            }

            _editId = null;
        });
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            var resultat = await Stock.AjouterArticleAsync(
                _nouveau.Nom,
                _nouveau.Quantite,
                _nouveau.Unite,
                _nouveau.SeuilAlerte,
                _nouveau.CategorieId);

            if (resultat.FusionProposee)
            {
                _fusionProposee = resultat;
                _fusionPending = new ArticleForm
                {
                    Nom = _nouveau.Nom,
                    Quantite = _nouveau.Quantite,
                    Unite = _nouveau.Unite,
                    SeuilAlerte = _nouveau.SeuilAlerte,
                    CategorieId = _nouveau.CategorieId
                };
                return;
            }

            _nouveau = new ArticleForm { CategorieId = _categories.FirstOrDefault()?.Id ?? 0 };
            if (resultat.FusionEffectuee)
            {
                _info = resultat.Message;
            }
        });
    }

    private async Task ConfirmerFusionAsync()
    {
        if (_fusionPending is null)
        {
            return;
        }

        var pending = _fusionPending;
        await RunAsync(async () =>
        {
            var resultat = await Stock.AjouterArticleAsync(
                pending.Nom,
                pending.Quantite,
                pending.Unite,
                pending.SeuilAlerte,
                pending.CategorieId,
                fusionnerSiExistant: true);

            _fusionProposee = null;
            _fusionPending = null;
            _nouveau = new ArticleForm { CategorieId = _categories.FirstOrDefault()?.Id ?? 0 };
            _info = resultat.Message;
        });
    }

    private void AnnulerFusion()
    {
        _fusionProposee = null;
        _fusionPending = null;
    }

    private async Task DeleteAsync(int id) =>
        await RunAsync(async () => await Stock.SupprimerArticleAsync(id));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ArticleForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le nom est obligatoire.")]
        [System.ComponentModel.DataAnnotations.MaxLength(128)]
        public string Nom { get; set; } = string.Empty;

        public decimal Quantite { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(32)]
        public string? Unite { get; set; }

        public decimal? SeuilAlerte { get; set; }

        public int CategorieId { get; set; }
    }
}
