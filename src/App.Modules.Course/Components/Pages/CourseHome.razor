@page "/course"
@* Liste à gauche ; stats, jeu de données, parcours magasins (+ mouvements stock si liaison) à droite. *@
@attribute [Authorize]
@using System.Globalization
@using App.Shared.Modules
@using Microsoft.JSInterop
@inject CourseService Course
@inject IActiveModuleGuard ModuleGuard
@inject IModuleLiaisonQuery Liaisons
@inject IStockArticleCatalogue StockArticles
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Courses</PageTitle>

@if (_ready)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0">Courses</h1>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleHistorique">
            @(_historique ? "Retour à la liste" : "Voir les articles achetés")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="course-dashboard">
        <div class="course-dashboard-col course-dashboard-liste">
            <WidgetCard Title="@(_historique ? "Articles achetés" : "Liste de courses")" Icon="bi-cart">
                @if (!_historique)
                {
                    <EditForm Model="_nouveau" OnValidSubmit="AjouterAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3">
                                <label class="form-label" for="article-nom">Ajouter un article</label>
                                <InputText id="article-nom" class="form-control form-control-sm" @bind-Value="_nouveau.Nom" />
                                <ValidationMessage For="() => _nouveau.Nom" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="article-qte">Quantité</label>
                                <InputText id="article-qte" class="form-control form-control-sm" @bind-Value="_nouveau.Quantite" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="article-cat">Catégorie</label>
                                <InputSelect id="article-cat" class="form-select form-select-sm" @bind-Value="_nouveau.CategorieId">
                                    @foreach (var categorie in _categories)
                                    {
                                        <option value="@categorie.Id">@categorie.Nom</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="article-mag">Magasin</label>
                                <InputSelect id="article-mag" class="form-select form-select-sm" @bind-Value="_nouveau.MagasinId">
                                    <option value="0">—</option>
                                    @foreach (var magasin in _magasins)
                                    {
                                        <option value="@magasin.Id">@magasin.Nom</option>
                                    }
                                </InputSelect>
                            </div>
                            @if (_stockActif)
                            {
                                <div class="col-md-2">
                                    <label class="form-label" for="article-stock">Article stock</label>
                                    <InputSelect id="article-stock" class="form-select form-select-sm" @bind-Value="_nouveau.ArticleStockId">
                                        <option value="0">—</option>
                                        @foreach (var stock in _articlesStock)
                                        {
                                            <option value="@stock.Id">@stock.Nom</option>
                                        }
                                    </InputSelect>
                                </div>
                            }
                            @if (_financeActif)
                            {
                                <div class="col-md-2">
                                    <label class="form-label" for="article-prix">Prix estimé</label>
                                    <InputNumber id="article-prix" class="form-control form-control-sm" @bind-Value="_nouveau.PrixEstime" />
                                </div>
                            }
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@(_busy || _categories.Count == 0)">Ajouter</button>
                            </div>
                        </div>
                    </EditForm>
                    @if (_categories.Count == 0)
                    {
                        <p class="text-muted small">Créez une catégorie dans l'administration avant d'ajouter un article.</p>
                    }
                }

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                @if (!_historique)
                                {
                                    <th><span class="visually-hidden">Acheté</span></th>
                                }
                                <th>Nom</th>
                                <th>Quantité</th>
                                <th>Catégorie</th>
                                <th>Magasin</th>
                                @if (_historique)
                                {
                                    <th>Acheté le</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_lignes.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(_historique ? 5 : 5)" class="text-muted text-center">
                                        @(_historique ? "Aucun article acheté pour le moment." : "Aucun article à acheter.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var article in _lignes)
                                {
                                    <tr>
                                        @if (!_historique)
                                        {
                                            <td>
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       disabled="@_busy"
                                                       checked="@article.Achete"
                                                       aria-label="@($"Marquer {article.Nom} comme acheté")"
                                                       @onchange="e => MarquerAsync(article.Id, (bool)(e.Value ?? false))" />
                                            </td>
                                        }
                                        <td>
                                            @article.Nom
                                            @if (LiaisonIncomplete(article))
                                            {
                                                <span class="text-muted ms-1"
                                                      title="Liaison active : renseignez le champ manquant pour synchroniser Stock/Finance.">
                                                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Liaison incomplete</span>
                                                </span>
                                            }
                                        </td>
                                        <td>@(article.Quantite ?? "—")</td>
                                        <td>
                                            <span class="finance-legend-swatch" style="background:@Swatch(article.Categorie.Couleur)"></span>
                                            @article.Categorie.Nom
                                        </td>
                                        <td>@(article.Magasin?.Nom ?? "—")</td>
                                        @if (_historique)
                                        {
                                            <td>@(article.DateAchat?.ToString("g", CultureInfo.GetCultureInfo("fr-FR")) ?? "—")</td>
                                        }
                                        <td class="text-nowrap text-end">
                                            @if (!_historique)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        disabled="@_busy"
                                                        @onclick="() => StartEdit(article)">
                                                    Modifier
                                                </button>
                                            }
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    disabled="@_busy"
                                                    @onclick="() => SupprimerAsync(article.Id, article.Nom)">
                                                Supprimer
                                            </button>
                                        </td>
                                    </tr>
                                    @if (_editId == article.Id)
                                    {
                                        <tr>
                                            <td colspan="6">
                                                <EditForm Model="_edit" OnValidSubmit="SauverEditAsync">
                                                    <DataAnnotationsValidator />
                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-md-3">
                                                            <label class="form-label" for="edit-nom">Nom</label>
                                                            <InputText id="edit-nom" class="form-control form-control-sm" @bind-Value="_edit.Nom" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label" for="edit-qte">Quantité</label>
                                                            <InputText id="edit-qte" class="form-control form-control-sm" @bind-Value="_edit.Quantite" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label" for="edit-cat">Catégorie</label>
                                                            <InputSelect id="edit-cat" class="form-select form-select-sm" @bind-Value="_edit.CategorieId">
                                                                @foreach (var categorie in _categories)
                                                                {
                                                                    <option value="@categorie.Id">@categorie.Nom</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label" for="edit-mag">Magasin</label>
                                                            <InputSelect id="edit-mag" class="form-select form-select-sm" @bind-Value="_edit.MagasinId">
                                                                <option value="0">—</option>
                                                                @foreach (var magasin in _magasins)
                                                                {
                                                                    <option value="@magasin.Id">@magasin.Nom</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        @if (_stockActif)
                                                        {
                                                            <div class="col-md-2">
                                                                <label class="form-label" for="edit-stock">Article stock</label>
                                                                <InputSelect id="edit-stock" class="form-select form-select-sm" @bind-Value="_edit.ArticleStockId">
                                                                    <option value="0">—</option>
                                                                    @foreach (var stock in _articlesStock)
                                                                    {
                                                                        <option value="@stock.Id">@stock.Nom</option>
                                                                    }
                                                                </InputSelect>
                                                            </div>
                                                        }
                                                        @if (_financeActif)
                                                        {
                                                            <div class="col-md-2">
                                                                <label class="form-label" for="edit-prix">Prix estimé</label>
                                                                <InputNumber id="edit-prix" class="form-control form-control-sm" @bind-Value="_edit.PrixEstime" />
                                                            </div>
                                                        }
                                                        <div class="col-auto">
                                                            <button type="submit" class="btn btn-primary btn-sm" disabled="@_busy">Enregistrer</button>
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _editId = null">Annuler</button>
                                                        </div>
                                                    </div>
                                                </EditForm>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </WidgetCard>
        </div>

        <div class="course-dashboard-col course-dashboard-side">
            <WidgetCard Title="Achats du mois">
                <CoursePieChart Slices="_repartition" EmptyText="Aucun achat enregistré ce mois-ci." />
            </WidgetCard>

            <div class="d-grid">
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled
                        title="Bientôt disponible">
                    Jeu de données
                </button>
            </div>

            <WidgetCard Title="Ordre des magasins à suivre">
                @if (_parcours.Count == 0)
                {
                    <p class="text-muted mb-0">Aucun magasin configuré.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Magasin</th>
                                    <th class="text-end">À acheter</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var magasin in _parcours)
                                {
                                    <tr class="@(magasin.Restants == 0 ? "text-muted" : null)">
                                        <td>@magasin.Nom</td>
                                        <td class="text-end">@magasin.Restants</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </WidgetCard>

            @if (_liaisonCourseStock)
            {
                <WidgetCard Title="Mouvements de stock" Icon="bi-box-seam">
                    <p class="text-muted mb-0">Les articles liés au stock s'incrémentent automatiquement à l'achat.</p>
                </WidgetCard>
            }
        </div>
    </div>
}

@code {
    private const string StockModuleKey = "stock";
    private const string FinanceModuleKey = "finance";

    private bool _ready;
    private bool _busy;
    private bool _historique;
    private bool _liaisonCourseStock;
    private bool _liaisonCourseFinance;
    private bool _stockActif;
    private bool _financeActif;
    private string? _error;
    private List<ArticleCourse> _lignes = [];
    private List<Categorie> _categories = [];
    private List<Magasin> _magasins = [];
    private List<MagasinRestants> _parcours = [];
    private IReadOnlyList<CourseCategoriePart> _repartition = [];
    private IReadOnlyList<StockArticleRef> _articlesStock = [];
    private NouvelArticleForm _nouveau = new();
    private int? _editId;
    private NouvelArticleForm _edit = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await CourseAccess.EnsureActiveAsync(ModuleGuard, Navigation))
        {
            return;
        }

        await ReloadAsync();
        _ready = true;
    }

    private async Task ReloadAsync()
    {
        _categories = await Course.ListerCategoriesAsync();
        _magasins = await Course.ListerMagasinsOrdonnes();
        _parcours = await Course.ListerMagasinsAvecRestantsAsync();
        _repartition = await Course.RepartitionParCategorie();
        _lignes = _historique
            ? await Course.ListerArticlesAchetes()
            : await Course.ListerArticlesAEnAcheter();
        _liaisonCourseStock = await Liaisons.IsLiaisonActiveAsync(CourseModule.ModuleKey, StockModuleKey);
        _liaisonCourseFinance = await Liaisons.IsLiaisonActiveAsync(CourseModule.ModuleKey, FinanceModuleKey);
        _stockActif = await ModuleGuard.IsModuleActiveAsync(StockModuleKey);
        _financeActif = await ModuleGuard.IsModuleActiveAsync(FinanceModuleKey);
        _articlesStock = _stockActif ? await StockArticles.ListerAsync() : [];

        if (_nouveau.CategorieId == 0 && _categories.Count > 0)
        {
            _nouveau.CategorieId = _categories[0].Id;
        }
    }

    private bool LiaisonIncomplete(ArticleCourse article)
    {
        if (_liaisonCourseStock && article.ArticleStockId is null)
        {
            return true;
        }

        if (_liaisonCourseFinance && article.PrixEstime is null)
        {
            return true;
        }

        return false;
    }

    private async Task ToggleHistorique()
    {
        _historique = !_historique;
        _editId = null;
        _error = null;
        await ReloadAsync();
    }

    private async Task MarquerAsync(int id, bool valeur)
    {
        _busy = true;
        _error = null;
        try
        {
            await Course.MarquerAchete(id, valeur);
            AppliquerMarquerLocal(id, valeur);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Met à jour listes / parcours / camembert en mémoire après une coche réussie
    /// (évite un ReloadAsync complet à chaque interaction).
    /// </summary>
    private void AppliquerMarquerLocal(int id, bool valeur)
    {
        var index = _lignes.FindIndex(a => a.Id == id);
        if (index < 0)
        {
            return;
        }

        var article = _lignes[index];

        if (!_historique && valeur)
        {
            _lignes.RemoveAt(index);
            AjusterParcours(article.MagasinId, -1);
            AjusterRepartitionMois(article, delta: 1);
            return;
        }

        if (_historique && !valeur)
        {
            _lignes.RemoveAt(index);
            AjusterParcours(article.MagasinId, +1);
            if (EstAchatDuMoisCourant(article.DateAchat))
            {
                AjusterRepartitionMois(article, delta: -1);
            }

            return;
        }

        article.Achete = valeur;
        article.DateAchat = valeur ? DateTime.Now : null;
    }

    private static bool EstAchatDuMoisCourant(DateTime? dateAchat)
    {
        if (dateAchat is not DateTime d)
        {
            return false;
        }

        var today = DateTime.Today;
        return d.Year == today.Year && d.Month == today.Month;
    }

    private void AjusterParcours(int? magasinId, int delta)
    {
        if (magasinId is not int mid || delta == 0)
        {
            return;
        }

        for (var i = 0; i < _parcours.Count; i++)
        {
            var row = _parcours[i];
            if (row.Id != mid)
            {
                continue;
            }

            _parcours[i] = row with { Restants = Math.Max(0, row.Restants + delta) };
            return;
        }
    }

    private void AjusterRepartitionMois(ArticleCourse article, int delta)
    {
        if (delta == 0)
        {
            return;
        }

        var cat = _categories.FirstOrDefault(c => c.Id == article.CategorieId);
        var nom = cat?.Nom ?? $"#{article.CategorieId}";
        var couleur = cat?.Couleur;
        var list = _repartition.ToList();
        var idx = list.FindIndex(p => string.Equals(p.Categorie, nom, StringComparison.Ordinal));
        if (idx >= 0)
        {
            var part = list[idx];
            var nouveau = part.Nombre + delta;
            if (nouveau <= 0)
            {
                list.RemoveAt(idx);
            }
            else
            {
                list[idx] = part with { Nombre = nouveau };
            }
        }
        else if (delta > 0)
        {
            list.Add(new CourseCategoriePart(nom, delta, couleur));
        }

        _repartition = list.OrderByDescending(p => p.Nombre).ToList();
    }

    private async Task SupprimerAsync(int id, string nom)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", $"Supprimer « {nom} » ?");
        if (!ok)
        {
            return;
        }

        await RunAsync(() => Course.SupprimerArticle(id));
    }

    private void StartEdit(ArticleCourse article)
    {
        _editId = article.Id;
        _edit = new NouvelArticleForm
        {
            Nom = article.Nom,
            Quantite = article.Quantite,
            CategorieId = article.CategorieId,
            MagasinId = article.MagasinId ?? 0,
            ArticleStockId = article.ArticleStockId ?? 0,
            PrixEstime = article.PrixEstime
        };
        _error = null;
    }

    private async Task SauverEditAsync()
    {
        if (_editId is not int id)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Course.ModifierArticle(new ArticleCourse
            {
                Id = id,
                Nom = _edit.Nom,
                Quantite = _edit.Quantite,
                CategorieId = _edit.CategorieId,
                MagasinId = _edit.MagasinId == 0 ? null : _edit.MagasinId,
                ArticleStockId = _edit.ArticleStockId == 0 ? null : _edit.ArticleStockId,
                PrixEstime = _edit.PrixEstime
            });
            _editId = null;
        });
    }

    private async Task AjouterAsync()
    {
        await RunAsync(async () =>
        {
            await Course.AjouterArticle(new ArticleCourse
            {
                Nom = _nouveau.Nom,
                Quantite = _nouveau.Quantite,
                CategorieId = _nouveau.CategorieId,
                MagasinId = _nouveau.MagasinId == 0 ? null : _nouveau.MagasinId,
                ArticleStockId = _nouveau.ArticleStockId == 0 ? null : _nouveau.ArticleStockId,
                PrixEstime = _nouveau.PrixEstime
            });
            var cat = _nouveau.CategorieId;
            var mag = _nouveau.MagasinId;
            _nouveau = new NouvelArticleForm { CategorieId = cat, MagasinId = mag };
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Swatch(string? couleur) =>
        string.IsNullOrWhiteSpace(couleur) ? "#6c757d" : couleur;

    private sealed class NouvelArticleForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le nom est obligatoire.")]
        [System.ComponentModel.DataAnnotations.MaxLength(128, ErrorMessage = "Le nom ne peut pas dépasser 128 caractères.")]
        public string Nom { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(64, ErrorMessage = "La quantité ne peut pas dépasser 64 caractères.")]
        public string? Quantite { get; set; }

        public int CategorieId { get; set; }

        public int MagasinId { get; set; }

        public int ArticleStockId { get; set; }

        public decimal? PrixEstime { get; set; }
    }
}
