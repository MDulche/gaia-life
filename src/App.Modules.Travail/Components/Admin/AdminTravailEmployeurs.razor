@inject TravailService Travail

<h3 class="h6 mt-4">Employeurs</h3>
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (_pendingDelete is not null)
{
    <div class="alert alert-warning" role="status">
        <p class="mb-2">Supprimer l'employeur « @_pendingDelete.Nom » ainsi que ses fiches de paie, congés et soldes ?</p>
        <button type="button" class="btn btn-danger btn-sm me-2" disabled="@_busy" @onclick="ConfirmDeleteAsync">Confirmer</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _pendingDelete = null">Annuler</button>
    </div>
}

<div class="table-responsive mb-3">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Début</th>
                <th>Fin</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_employeurs.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted text-center">Aucun employeur pour le moment.</td>
                </tr>
            }
            else
            {
                @foreach (var employeur in _employeurs)
                {
                    <tr>
                        @if (_editId == employeur.Id)
                        {
                            <td><InputText class="form-control form-control-sm" @bind-Value="_editNom" /></td>
                            <td><InputText class="form-control form-control-sm" @bind-Value="_editAdresse" /></td>
                            <td><InputDate class="form-control form-control-sm" @bind-Value="_editDebut" /></td>
                            <td><InputDate class="form-control form-control-sm" @bind-Value="_editFin" /></td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveEditAsync">Enregistrer</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _editId = null">Annuler</button>
                            </td>
                        }
                        else
                        {
                            <td>@employeur.Nom</td>
                            <td>@(employeur.Adresse ?? "—")</td>
                            <td>@employeur.DateDebut.ToString("d")</td>
                            <td>@(employeur.DateFin?.ToString("d") ?? "en cours")</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => StartEdit(employeur)">Modifier</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="() => _pendingDelete = employeur">Supprimer</button>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<EditForm Model="_nouveau" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="emp-nom">Nom</label>
            <InputText id="emp-nom" class="form-control form-control-sm" @bind-Value="_nouveau.Nom" />
            <ValidationMessage For="() => _nouveau.Nom" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="emp-adresse">Adresse</label>
            <InputText id="emp-adresse" class="form-control form-control-sm" @bind-Value="_nouveau.Adresse" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="emp-debut">Début</label>
            <InputDate id="emp-debut" class="form-control form-control-sm" @bind-Value="_nouveau.DateDebut" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="emp-fin">Fin</label>
            <InputDate id="emp-fin" class="form-control form-control-sm" @bind-Value="_nouveau.DateFin" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@_busy">Ajouter</button>
        </div>
    </div>
</EditForm>

@code {
    private bool _busy;
    private string? _error;
    private List<Employeur> _employeurs = [];
    private Employeur? _pendingDelete;
    private int? _editId;
    private string _editNom = string.Empty;
    private string? _editAdresse;
    private DateTime _editDebut = DateTime.Today;
    private DateTime? _editFin;
    private EmployeurForm _nouveau = EmployeurForm.Create();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _employeurs = await Travail.ListerEmployeursAsync();

    private void StartEdit(Employeur employeur)
    {
        _editId = employeur.Id;
        _editNom = employeur.Nom;
        _editAdresse = employeur.Adresse;
        _editDebut = employeur.DateDebut;
        _editFin = employeur.DateFin;
        _error = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editId is not int id)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Travail.ModifierEmployeurAsync(id, _editNom, _editAdresse, _editDebut, _editFin);
            _editId = null;
        });
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null)
        {
            return;
        }

        var id = _pendingDelete.Id;
        await RunAsync(async () =>
        {
            await Travail.SupprimerEmployeurAsync(id);
            _pendingDelete = null;
        });
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            await Travail.AjouterEmployeurAsync(_nouveau.Nom, _nouveau.Adresse, _nouveau.DateDebut, _nouveau.DateFin);
            _nouveau = EmployeurForm.Create();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class EmployeurForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le nom est obligatoire.")]
        [System.ComponentModel.DataAnnotations.MaxLength(128, ErrorMessage = "Le nom ne peut pas dépasser 128 caractères.")]
        public string Nom { get; set; } = string.Empty;

        public string? Adresse { get; set; }

        public DateTime DateDebut { get; set; }

        public DateTime? DateFin { get; set; }

        public static EmployeurForm Create() => new() { DateDebut = DateTime.Today };
    }
}
