@* Widget accueil : solde de l'employeur principal et dernière fiche de paie. *@
@inject TravailService Travail

<WidgetCard Title="Travail" Icon="bi-briefcase">
    @if (_loading)
    {
        <p class="text-muted mb-0">Chargement…</p>
    }
    else if (_employeur is null)
    {
        <p class="text-muted mb-0">Aucun employeur enregistré.</p>
    }
    else
    {
        <p class="mb-1"><strong>@_employeur.Nom</strong></p>
        <p class="widget-metric mb-2">@TravailFormat.Jours(_solde?.JoursRestants ?? 0) restants</p>
        @if (_fiche is null)
        {
            <p class="text-muted small mb-0">Aucune fiche de paie.</p>
        }
        else
        {
            <p class="small mb-0">
                Dernière paie · @TravailFormat.Mois(_fiche.Mois)
                · @TravailFormat.Euro(_fiche.SalaireNet)
            </p>
        }
    }
</WidgetCard>

@code {
    private bool _loading = true;
    private Employeur? _employeur;
    private SoldeCongesInfo? _solde;
    private FichePaie? _fiche;

    protected override async Task OnInitializedAsync()
    {
        _employeur = await Travail.GetEmployeurActifAsync();
        if (_employeur is not null)
        {
            _solde = await Travail.SoldeCongesActuel(_employeur.Id, DateTime.Today.Year);
            _fiche = await Travail.DerniereFichePaieAsync(_employeur.Id);
        }

        _loading = false;
    }
}
