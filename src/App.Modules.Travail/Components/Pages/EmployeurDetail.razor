@page "/travail/employeurs/{Id:int}"
@* Tableau de bord employeur : salaire, congés / HS, fiches, graphique 12 mois. *@
@attribute [Authorize]
@using System.Globalization
@inject TravailService Travail
@inject IActiveModuleGuard ModuleGuard
@inject NavigationManager Navigation

<PageTitle>@( _employeur?.Nom ?? "Employeur" )</PageTitle>

@if (_ready && _employeur is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
        <div>
            <p class="mb-1"><a href="/travail">← Travail</a></p>
            <h1 class="h3 mb-1">@_employeur.Nom</h1>
            <p class="text-muted mb-0">
                @_employeur.DateDebut.ToString("d")
                — @(_employeur.DateFin?.ToString("d") ?? "en cours")
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="travail-dashboard">
        <div class="travail-dashboard-col">
            <WidgetCard Title="Salaire" Icon="bi-cash-coin">
                @if (_derniereFiche is null)
                {
                    <p class="text-muted mb-0">Aucune fiche de paie enregistrée.</p>
                }
                else
                {
                    <p class="finance-account-primary mb-1">@TravailFormat.Euro(_derniereFiche.SalaireNet)</p>
                    <p class="finance-account-secondary text-muted mb-0">
                        Brut @TravailFormat.Euro(_derniereFiche.SalaireBrut)
                        <span class="ms-1">· @TravailFormat.Mois(_derniereFiche.Mois)</span>
                    </p>
                }
            </WidgetCard>

            <div class="travail-pair">
                <WidgetCard Title="Congés" Icon="bi-calendar-check">
                    @if (_solde is null)
                    {
                        <p class="text-muted mb-0">Solde indisponible.</p>
                    }
                    else
                    {
                        <p class="finance-account-primary mb-0">@TravailFormat.Jours(_solde.JoursRestants)</p>
                        <p class="small text-muted mb-0">Année @_solde.Annee</p>
                    }
                </WidgetCard>

                <WidgetCard Title="Heures supplémentaires" Icon="bi-clock-history">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <p class="finance-account-primary mb-0">@TravailFormat.Heures(_totalHs)</p>
                            <p class="small text-muted mb-0">Mois en cours</p>
                        </div>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@_busy"
                                @onclick="ToggleHs">
                            @(_showHs ? "Fermer" : "Ajouter")
                        </button>
                    </div>
                </WidgetCard>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary flex-fill" @onclick="TogglePaie">
                    @(_showPaie ? "Fermer la fiche" : "Entrer une fiche de paie")
                </button>
                <button type="button" class="btn btn-outline-primary flex-fill" @onclick="ToggleHistoriqueComplet">
                    @(_historiqueComplet ? "Voir 12 derniers mois" : "Consulter les fiches de paie")
                </button>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary flex-fill" @onclick="ToggleConge">
                    @(_showConge ? "Fermer le congé" : "Entrer un congé")
                </button>
                <button type="button" class="btn btn-outline-primary flex-fill" @onclick="ToggleConsulterConges">
                    @(_voirConges ? "Masquer mes congés" : "Consulter mes congés")
                </button>
            </div>

            @if (_showHs)
            {
                <WidgetCard Title="Ajouter des heures supplémentaires">
                    <EditForm Model="_hs" OnValidSubmit="CreateHsAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" for="hs-date">Date</label>
                                <InputDate id="hs-date" class="form-control" @bind-Value="_hs.Date" />
                                <ValidationMessage For="() => _hs.Date" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="hs-debut">Heure de début</label>
                                <input id="hs-debut" type="time" class="form-control"
                                       value="@_hs.DebutInput"
                                       @onchange="e => { _hs.DebutInput = e.Value?.ToString() ?? string.Empty; }" />
                                <ValidationMessage For="() => _hs.DebutInput" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="hs-fin">Heure de fin</label>
                                <input id="hs-fin" type="time" class="form-control"
                                       value="@_hs.FinInput"
                                       @onchange="e => { _hs.FinInput = e.Value?.ToString() ?? string.Empty; }" />
                                <ValidationMessage For="() => _hs.FinInput" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="hs-contexte">Contexte</label>
                                <InputText id="hs-contexte" class="form-control" @bind-Value="_hs.Contexte"
                                           placeholder="Ex. Remplacement collègue, Clôture mensuelle" />
                                <ValidationMessage For="() => _hs.Contexte" />
                            </div>
                            <div class="col-12">
                                <p class="mb-2">
                                    Durée :
                                    @if (_hs.TryGetDuree(out var dureePreview))
                                    {
                                        <strong>@TravailFormat.Heures(dureePreview)</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </p>
                                <button type="submit" class="btn btn-primary" disabled="@_busy">Enregistrer</button>
                            </div>
                        </div>
                    </EditForm>
                </WidgetCard>
            }

            @if (_showConge)
            {
                <WidgetCard Title="Nouvelle demande de congé">
                    <EditForm Model="_conge" OnValidSubmit="CreateCongeAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="conge-type">Type</label>
                                <InputSelect id="conge-type" class="form-select" @bind-Value="_conge.Type">
                                    @foreach (var type in Enum.GetValues<TypeConge>())
                                    {
                                        <option value="@type">@TravailFormat.Type(type)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="conge-jours">Nombre de jours</label>
                                <InputNumber id="conge-jours" class="form-control" @bind-Value="_conge.NombreJours" />
                                <div class="form-text">Calculé en jours ouvrés (lun–ven). Ajustable pour une demi-journée.</div>
                                <ValidationMessage For="() => _conge.NombreJours" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="conge-debut">Date de début</label>
                                <InputDate id="conge-debut" class="form-control" @bind-Value="_conge.DateDebut" @bind-Value:after="RecalcJours" />
                                <ValidationMessage For="() => _conge.DateDebut" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="conge-fin">Date de fin</label>
                                <InputDate id="conge-fin" class="form-control" @bind-Value="_conge.DateFin" @bind-Value:after="RecalcJours" />
                                <ValidationMessage For="() => _conge.DateFin" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="conge-com">Commentaire (optionnel)</label>
                                <InputText id="conge-com" class="form-control" @bind-Value="_conge.Commentaire" />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary" disabled="@_busy">Envoyer la demande</button>
                            </div>
                        </div>
                    </EditForm>
                </WidgetCard>
            }

            @if (_voirConges)
            {
                <WidgetCard Title="Mes congés">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Dates</th>
                                    <th class="text-end">Jours</th>
                                    <th>Statut</th>
                                    <AuthorizeView Roles="@TravailService.RoleAdmin">
                                        <Authorized>
                                            <th class="text-end">Actions</th>
                                        </Authorized>
                                    </AuthorizeView>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_conges.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted text-center">Aucun congé pour le moment.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var conge in _conges)
                                    {
                                        <tr>
                                            <td>@TravailFormat.Type(conge.Type)</td>
                                            <td>@conge.DateDebut.ToString("d") — @conge.DateFin.ToString("d")</td>
                                            <td class="text-end">@TravailFormat.Jours(conge.NombreJours)</td>
                                            <td>
                                                <span class="badge @TravailFormat.BadgeCss(conge.Statut)">
                                                    @TravailFormat.Statut(conge.Statut)
                                                </span>
                                            </td>
                                            <AuthorizeView Roles="@TravailService.RoleAdmin">
                                                <Authorized>
                                                    <td class="text-end text-nowrap">
                                                        @if (conge.Statut == StatutConge.EnAttente)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-success me-1" disabled="@_busy"
                                                                    @onclick="() => ChangerStatutAsync(conge.Id, StatutConge.Valide)">Valider</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                                                    @onclick="() => ChangerStatutAsync(conge.Id, StatutConge.Refuse)">Refuser</button>
                                                        }
                                                    </td>
                                                </Authorized>
                                            </AuthorizeView>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </WidgetCard>
            }

            @if (_showPaie)
            {
                <WidgetCard Title="Nouvelle fiche de paie">
                    <EditForm Model="_fiche" OnValidSubmit="CreateFicheAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="fiche-mois">Mois</label>
                                <input id="fiche-mois" type="month" class="form-control" value="@_fiche.MoisInput"
                                       @onchange="e => _fiche.MoisInput = e.Value?.ToString() ?? _fiche.MoisInput" />
                                <ValidationMessage For="() => _fiche.MoisInput" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="fiche-brut">Salaire brut (€)</label>
                                <InputNumber id="fiche-brut" class="form-control" @bind-Value="_fiche.SalaireBrut" />
                                <ValidationMessage For="() => _fiche.SalaireBrut" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="fiche-net">Salaire net (€)</label>
                                <InputNumber id="fiche-net" class="form-control" @bind-Value="_fiche.SalaireNet" />
                                <ValidationMessage For="() => _fiche.SalaireNet" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="fiche-cotis">Cotisations (€)</label>
                                <InputNumber id="fiche-cotis" class="form-control" @bind-Value="_fiche.TotalCotisations" />
                                <ValidationMessage For="() => _fiche.TotalCotisations" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="fiche-note">Note (optionnel)</label>
                                <InputText id="fiche-note" class="form-control" @bind-Value="_fiche.Note" />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary" disabled="@_busy">Enregistrer</button>
                            </div>
                        </div>
                    </EditForm>
                </WidgetCard>
            }
        </div>

        <div class="travail-dashboard-col">
            <WidgetCard Title="Graphique">
                <p class="text-muted mb-0">Statistiques à configurer</p>
            </WidgetCard>

            <WidgetCard Title="@(_historiqueComplet ? "Toutes les fiches de paie" : "Historique des fiches de paie")">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mois</th>
                                <th class="text-end">Salaire net</th>
                                <th class="text-end">Salaire brut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_fichesAffichees.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-muted text-center">Aucune fiche de paie enregistrée</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var fiche in _fichesAffichees)
                                {
                                    <tr>
                                        <td>@TravailFormat.Mois(fiche.Mois)</td>
                                        <td class="text-end">@TravailFormat.Euro(fiche.SalaireNet)</td>
                                        <td class="text-end">@TravailFormat.Euro(fiche.SalaireBrut)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </WidgetCard>

            <WidgetCard Title="Évolution du salaire net (12 mois)">
                <TravailSalaireNetChart Points="_pointsSalaire" EmptyText="Aucune fiche de paie sur les 12 derniers mois." />
            </WidgetCard>
        </div>
    </div>
}
else if (_ready)
{
    <p class="text-muted">Employeur introuvable. <a href="/travail">Retour</a></p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _ready;
    private bool _busy;
    private bool _showPaie;
    private bool _showHs;
    private bool _showConge;
    private bool _voirConges;
    private bool _historiqueComplet;
    private string? _error;
    private Employeur? _employeur;
    private FichePaie? _derniereFiche;
    private SoldeCongesInfo? _solde;
    private decimal _totalHs;
    private List<FichePaie> _fiches12 = [];
    private List<FichePaie> _fichesToutes = [];
    private List<Conge> _conges = [];
    private IReadOnlyList<TravailSalaireNetChart.SalaireNetPoint> _pointsSalaire = [];
    private NewFicheModel _fiche = NewFicheModel.Create();
    private NewHsModel _hs = NewHsModel.Create();
    private NewCongeModel _conge = NewCongeModel.Create();

    private List<FichePaie> _fichesAffichees => _historiqueComplet ? _fichesToutes : _fiches12;

    protected override async Task OnParametersSetAsync()
    {
        if (!await TravailAccess.EnsureActiveAsync(ModuleGuard, Navigation))
        {
            return;
        }

        await ReloadAsync();
        _ready = true;
    }

    private async Task ReloadAsync()
    {
        _error = null;
        _employeur = await Travail.GetEmployeurAsync(Id);
        if (_employeur is null)
        {
            return;
        }

        _derniereFiche = await Travail.DerniereFichePaieAsync(Id);
        _solde = await Travail.SoldeCongesActuel(Id, DateTime.Today.Year);
        _totalHs = await Travail.TotalHeuresSupMoisEnCours(Id);
        _fiches12 = await Travail.ListerFiches12DerniersMois(Id);
        _fichesToutes = await Travail.ListerFichesPaie(Id);
        _conges = await Travail.ListerConges(Id);
        _pointsSalaire = BuildPointsSalaire(_fiches12);
    }

    private static IReadOnlyList<TravailSalaireNetChart.SalaireNetPoint> BuildPointsSalaire(IEnumerable<FichePaie> fiches)
    {
        var debut = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-11);
        return fiches
            .Where(f => f.Mois >= debut)
            .OrderBy(f => f.Mois)
            .Select(f => new TravailSalaireNetChart.SalaireNetPoint(f.Mois, f.SalaireNet))
            .ToList();
    }

    private void TogglePaie()
    {
        _showPaie = !_showPaie;
        if (_showPaie)
        {
            _showHs = false;
            _showConge = false;
        }
    }

    private void ToggleHs()
    {
        _showHs = !_showHs;
        if (_showHs)
        {
            _showPaie = false;
            _showConge = false;
            _hs = NewHsModel.Create();
        }
    }

    private void ToggleConge()
    {
        _showConge = !_showConge;
        if (_showConge)
        {
            _showPaie = false;
            _showHs = false;
            _conge = NewCongeModel.Create();
        }
    }

    private void ToggleConsulterConges() => _voirConges = !_voirConges;

    private void RecalcJours()
    {
        _conge.NombreJours = TravailCalendrier.CompterJoursOuvres(_conge.DateDebut, _conge.DateFin);
    }

    private async Task ToggleHistoriqueComplet()
    {
        _historiqueComplet = !_historiqueComplet;
        if (_historiqueComplet && _fichesToutes.Count == 0)
        {
            _fichesToutes = await Travail.ListerFichesPaie(Id);
        }
    }

    private async Task CreateHsAsync()
    {
        if (!_hs.TryParseTimes(out var debut, out var fin))
        {
            _error = "Indiquez des heures de début et de fin valides.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Travail.AjouterHeureSup(new HeureSupplementaire
            {
                EmployeurId = Id,
                Date = _hs.Date,
                HeureDebut = debut,
                HeureFin = fin,
                Contexte = _hs.Contexte
            });
            _totalHs = await Travail.TotalHeuresSupMoisEnCours(Id);
            _hs = NewHsModel.Create();
            _showHs = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateCongeAsync()
    {
        await RunAsync(async () =>
        {
            await Travail.DemanderConge(new Conge
            {
                EmployeurId = Id,
                Type = _conge.Type,
                DateDebut = _conge.DateDebut,
                DateFin = _conge.DateFin,
                NombreJours = _conge.NombreJours,
                Commentaire = _conge.Commentaire
            });
            _conge = NewCongeModel.Create();
            _showConge = false;
            _voirConges = true;
        });
    }

    private async Task CreateFicheAsync()
    {
        if (!DateTime.TryParse(_fiche.MoisInput + "-01", out var mois))
        {
            _error = "Le mois est obligatoire.";
            return;
        }

        await RunAsync(async () =>
        {
            await Travail.AjouterFichePaie(new FichePaie
            {
                EmployeurId = Id,
                Mois = mois,
                SalaireBrut = _fiche.SalaireBrut,
                SalaireNet = _fiche.SalaireNet,
                TotalCotisations = _fiche.TotalCotisations,
                DateEmission = DateTime.Now,
                Note = _fiche.Note
            });
            _fiche = NewFicheModel.Create();
            _showPaie = false;
        });
    }

    private async Task ChangerStatutAsync(int congeId, StatutConge statut) =>
        await RunAsync(() => Travail.ChangerStatutConge(congeId, statut));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class NewFicheModel : System.ComponentModel.DataAnnotations.IValidatableObject
    {
        public string MoisInput { get; set; } = string.Empty;
        public decimal SalaireBrut { get; set; }
        public decimal SalaireNet { get; set; }
        public decimal TotalCotisations { get; set; }
        public string? Note { get; set; }

        public static NewFicheModel Create()
        {
            var today = DateTime.Today;
            return new NewFicheModel { MoisInput = $"{today.Year:D4}-{today.Month:D2}" };
        }

        public IEnumerable<System.ComponentModel.DataAnnotations.ValidationResult> Validate(
            System.ComponentModel.DataAnnotations.ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(MoisInput))
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Le mois est obligatoire.", [nameof(MoisInput)]);
            }

            if (SalaireBrut < 0)
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Le salaire brut ne peut pas être négatif.", [nameof(SalaireBrut)]);
            }

            if (SalaireNet < 0)
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Le salaire net ne peut pas être négatif.", [nameof(SalaireNet)]);
            }

            if (TotalCotisations < 0)
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Les cotisations ne peuvent pas être négatives.", [nameof(TotalCotisations)]);
            }
        }
    }

    private sealed class NewCongeModel : System.ComponentModel.DataAnnotations.IValidatableObject
    {
        public TypeConge Type { get; set; } = TypeConge.Paye;
        public DateTime DateDebut { get; set; }
        public DateTime DateFin { get; set; }
        public decimal NombreJours { get; set; }
        public string? Commentaire { get; set; }

        public static NewCongeModel Create()
        {
            var today = DateTime.Today;
            return new NewCongeModel
            {
                DateDebut = today,
                DateFin = today,
                NombreJours = TravailCalendrier.CompterJoursOuvres(today, today)
            };
        }

        public IEnumerable<System.ComponentModel.DataAnnotations.ValidationResult> Validate(
            System.ComponentModel.DataAnnotations.ValidationContext validationContext)
        {
            if (DateFin.Date < DateDebut.Date)
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "La date de fin ne peut pas être antérieure à la date de début.",
                    [nameof(DateFin)]);
            }

            if (NombreJours <= 0)
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Le nombre de jours doit être strictement positif.",
                    [nameof(NombreJours)]);
            }
        }
    }

    private sealed class NewHsModel : System.ComponentModel.DataAnnotations.IValidatableObject
    {
        public DateTime Date { get; set; }
        public string DebutInput { get; set; } = "18:00";
        public string FinInput { get; set; } = "20:00";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le contexte est obligatoire.")]
        [System.ComponentModel.DataAnnotations.MaxLength(256, ErrorMessage = "Le contexte ne peut pas dépasser 256 caractères.")]
        public string Contexte { get; set; } = string.Empty;

        public static NewHsModel Create() => new() { Date = DateTime.Today };

        public bool TryParseTimes(out TimeSpan debut, out TimeSpan fin)
        {
            debut = default;
            fin = default;
            return TryParseTime(DebutInput, out debut) && TryParseTime(FinInput, out fin);
        }

        private static bool TryParseTime(string? value, out TimeSpan time)
        {
            time = default;
            if (string.IsNullOrWhiteSpace(value))
            {
                return false;
            }

            return TimeSpan.TryParseExact(value.Trim(), @"hh\:mm", CultureInfo.InvariantCulture, out time)
                || TimeSpan.TryParseExact(value.Trim(), @"hh\:mm\:ss", CultureInfo.InvariantCulture, out time)
                || TimeSpan.TryParse(value.Trim(), CultureInfo.InvariantCulture, out time);
        }

        public bool TryGetDuree(out decimal heures)
        {
            heures = 0;
            if (!TryParseTimes(out var debut, out var fin) || fin <= debut)
            {
                return false;
            }

            heures = decimal.Round((decimal)(fin - debut).TotalHours, 2);
            return true;
        }

        public IEnumerable<System.ComponentModel.DataAnnotations.ValidationResult> Validate(
            System.ComponentModel.DataAnnotations.ValidationContext validationContext)
        {
            if (!TryParseTimes(out var debut, out var fin))
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Indiquez des heures valides (HH:mm).", [nameof(DebutInput), nameof(FinInput)]);
                yield break;
            }

            if (fin <= debut)
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "L'heure de fin doit être postérieure à l'heure de début.",
                    [nameof(FinInput)]);
            }
        }
    }
}
