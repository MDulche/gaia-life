@page "/travail/employeurs/{Id:int}/solde-conges"
@* Ancienne saisie des jours acquis : redirigée vers l'administration. *@
<!-- Mobile : pas d'Authorize / Identity (mono-utilisateur, CONTRAT-MIGRATION-MOBILE.md). -->
@inject IActiveModuleGuard ModuleGuard
@inject NavigationManager Navigation

@code {
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!await TravailAccess.EnsureActiveAsync(ModuleGuard, Navigation))
        {
            return;
        }

        Navigation.NavigateTo("/admin/travail/soldes-conges", replace: true);
    }
}
