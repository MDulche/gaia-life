@* Conteneur commun des widgets d'accueil (Finance, Travail, …). *@
<div class="widget-card card shadow-sm h-100">
    <div class="card-body d-flex flex-column">
        <h3 class="widget-card-title h6 mb-2 d-flex align-items-center justify-content-between gap-2">
            <span>
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <span class="module-icon @Icon me-1" aria-hidden="true"></span>
                }
                @Title
            </span>
            @if (TitleAccessory is not null)
            {
                <span class="widget-card-title-extra fw-normal">@TitleAccessory</span>
            }
        </h3>
        <div class="widget-card-content flex-grow-1">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? TitleAccessory { get; set; }
}
