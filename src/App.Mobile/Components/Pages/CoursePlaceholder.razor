@page "/course"
@inject IActiveModuleGuard ModuleGuard

<h1>Courses</h1>
@if (_ready)
{
    @if (_active)
    {
        <p class="text-muted">Module non porté — en attente de l’agent Course.</p>
    }
    else
    {
        <p class="text-muted">Module désactivé.</p>
    }
}

@code {
    private bool _ready;
    private bool _active;

    protected override async Task OnInitializedAsync()
    {
        _active = await ModuleGuard.IsModuleActiveAsync("course");
        _ready = true;
    }
}
