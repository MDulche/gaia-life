@page "/finance/comptes/{CompteId:int}/transactions/nouvelle"
@page "/finance/comptes/{CompteId:int}/transactions/{TransactionId:int}"
@* Création / édition d'une transaction. Le montant est toujours positif ; le type donne le signe. *@
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject FinanceService Finance
@inject IActiveModuleGuard ModuleGuard
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Modifier la transaction" : "Nouvelle transaction")</PageTitle>

@if (_ready)
{
    <p class="mb-1"><a href="@($"/finance/comptes/{CompteId}")">← Retour au compte</a></p>
    <h1 class="h3 mb-4">@(IsEdit ? "Modifier la transaction" : "Nouvelle transaction")</h1>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (!_lectureSeule)
    {
    <EditForm Model="Input" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label" for="tx-montant">Montant (€)</label>
            <InputNumber id="tx-montant" class="form-control" @bind-Value="Input.Montant" step="0.01" />
            <div class="form-text">Saisissez un montant strictement positif. Le signe est déterminé par le type.</div>
            <ValidationMessage For="() => Input.Montant" />
        </div>

        <fieldset class="mb-3">
            <legend class="form-label fs-6">Type</legend>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="type-entree" name="type" checked="@(Input.Type == TypeTransaction.Entree)" @onchange="() => Input.Type = TypeTransaction.Entree" />
                <label class="form-check-label" for="type-entree">Entrée</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="type-sortie" name="type" checked="@(Input.Type == TypeTransaction.Sortie)" @onchange="() => Input.Type = TypeTransaction.Sortie" />
                <label class="form-check-label" for="type-sortie">Sortie</label>
            </div>
        </fieldset>

        <div class="mb-3">
            <label class="form-label" for="tx-categorie">Catégorie</label>
            <InputSelect id="tx-categorie" class="form-select" @bind-Value="Input.CategorieChoice">
                <option value="">Choisir…</option>
                @foreach (var categorie in _categories.Where(c =>
                    !string.Equals(c.Nom, FinanceService.CategorieVirementInterne, StringComparison.Ordinal)))
                {
                    <option value="@categorie.Nom">@categorie.Nom</option>
                }
                <option value="__new__">+ Nouvelle catégorie…</option>
            </InputSelect>
            <ValidationMessage For="() => Input.CategorieChoice" />
        </div>

        @if (Input.CategorieChoice == "__new__")
        {
            <div class="mb-3">
                <label class="form-label" for="tx-categorie-new">Nom de la nouvelle catégorie</label>
                <InputText id="tx-categorie-new" class="form-control" @bind-Value="Input.NouvelleCategorie" />
                <ValidationMessage For="() => Input.NouvelleCategorie" />
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="tx-date">Date</label>
            <InputDate id="tx-date" class="form-control" @bind-Value="Input.Date" />
            <ValidationMessage For="() => Input.Date" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="tx-note">Note (optionnel)</label>
            <InputTextArea id="tx-note" class="form-control" @bind-Value="Input.Note" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_busy">Enregistrer</button>
    </EditForm>
    }
}

@code {
    [Parameter]
    public int CompteId { get; set; }

    [Parameter]
    public int? TransactionId { get; set; }

    private bool IsEdit => TransactionId is > 0;

    private bool _ready;
    private bool _busy;
    private bool _lectureSeule;
    private string? _error;
    private List<Categorie> _categories = [];
    private TransactionModel Input { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!await FinanceAccess.EnsureActiveAsync(ModuleGuard, Navigation))
        {
            return;
        }

        var compte = await Finance.GetCompteAsync(CompteId);
        if (compte is null)
        {
            Navigation.NavigateTo("/finance", replace: true);
            return;
        }

        _categories = await Finance.ListerCategoriesAsync();
        if (IsEdit)
        {
            var existing = await Finance.GetTransactionAsync(TransactionId!.Value);
            if (existing is null || existing.CompteId != CompteId)
            {
                Navigation.NavigateTo($"/finance/comptes/{CompteId}", replace: true);
                return;
            }

            if (existing.EstVirementInterne || existing.TransfertId is not null)
            {
                _error = "Les virements internes ne sont pas modifiables. Supprimez-les puis recréez un virement.";
                _lectureSeule = true;
                _ready = true;
                return;
            }

            _lectureSeule = false;
            Input = TransactionModel.From(existing);
        }
        else if (!_ready)
        {
            Input = new TransactionModel();
        }

        _ready = true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var categorie = Input.ResolvedCategorie();
            if (Input.CategorieChoice == "__new__")
            {
                await Finance.EnsureCategorieAsync(categorie);
            }

            var transaction = new Transaction
            {
                Id = TransactionId ?? 0,
                CompteId = CompteId,
                Date = Input.Date,
                Montant = Input.Montant,
                Type = Input.Type,
                Categorie = categorie,
                Note = Input.Note
            };

            if (IsEdit)
            {
                await Finance.ModifierTransactionAsync(transaction);
            }
            else
            {
                await Finance.AjouterTransaction(transaction);
            }

            Navigation.NavigateTo($"/finance/comptes/{CompteId}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class TransactionModel : IValidatableObject
    {
        public decimal Montant { get; set; }

        public TypeTransaction Type { get; set; } = TypeTransaction.Sortie;

        public string CategorieChoice { get; set; } = string.Empty;

        public string NouvelleCategorie { get; set; } = string.Empty;

        public DateTime Date { get; set; } = DateTime.Today;

        [MaxLength(500)]
        public string? Note { get; set; }

        public static TransactionModel From(Transaction transaction) => new()
        {
            Montant = transaction.Montant,
            Type = transaction.Type,
            CategorieChoice = transaction.Categorie,
            Date = transaction.Date.Date,
            Note = transaction.Note
        };

        public string ResolvedCategorie()
        {
            if (CategorieChoice == "__new__")
            {
                if (string.IsNullOrWhiteSpace(NouvelleCategorie))
                {
                    throw new InvalidOperationException("Indiquez le nom de la nouvelle catégorie.");
                }

                return NouvelleCategorie.Trim();
            }

            if (string.IsNullOrWhiteSpace(CategorieChoice))
            {
                throw new InvalidOperationException("Choisissez une catégorie.");
            }

            return CategorieChoice;
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Montant <= 0)
            {
                yield return new ValidationResult("Le montant doit être strictement positif.", [nameof(Montant)]);
            }

            if (Date.Date > DateTime.Today.AddDays(1))
            {
                yield return new ValidationResult("La date ne peut pas être plus d'un jour dans le futur.", [nameof(Date)]);
            }

            if (string.IsNullOrWhiteSpace(CategorieChoice))
            {
                yield return new ValidationResult("Choisissez une catégorie.", [nameof(CategorieChoice)]);
            }
            else if (CategorieChoice == "__new__" && string.IsNullOrWhiteSpace(NouvelleCategorie))
            {
                yield return new ValidationResult("Indiquez le nom de la nouvelle catégorie.", [nameof(NouvelleCategorie)]);
            }
        }
    }
}
