@inject FinanceService Finance

<h3 class="h6 mt-4">Catégories du camembert</h3>
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_pendingDelete is not null)
{
    <div class="alert alert-warning" role="alertdialog">
        @if (_pendingDelete.NombreTransactions > 0)
        {
            <p class="mb-2">
                <strong>@_pendingDelete.NombreTransactions</strong> transaction(s) utilisent encore
                la catégorie « @_pendingDelete.Nom ».
                Vous pouvez les réassigner automatiquement vers
                « @FinanceService.CategorieNonCategorise », puis supprimer la catégorie, ou annuler.
            </p>
            <button type="button" class="btn btn-warning btn-sm me-2" disabled="@_busy"
                    @onclick="ConfirmReassignAndDeleteAsync">
                Réassigner vers « @FinanceService.CategorieNonCategorise » et supprimer
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy"
                    @onclick="() => _pendingDelete = null">
                Annuler
            </button>
        }
        else
        {
            <p class="mb-2">Supprimer la catégorie « @_pendingDelete.Nom » ?</p>
            <button type="button" class="btn btn-danger btn-sm me-2" disabled="@_busy"
                    @onclick="ConfirmDeleteEmptyAsync">
                Confirmer
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy"
                    @onclick="() => _pendingDelete = null">
                Annuler
            </button>
        }
    </div>
}

<div class="table-responsive mb-3">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Couleur</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_categories.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-muted text-center">Aucune catégorie pour le moment.</td>
                </tr>
            }
            else
            {
                @foreach (var categorie in _categories)
                {
                    var systeme = IsSysteme(categorie.Nom);
                    <tr>
                        @if (_editId == categorie.Id)
                        {
                            <td><InputText class="form-control form-control-sm" @bind-Value="_editNom" /></td>
                            <td>
                                <input type="color" class="form-control form-control-color form-control-sm" value="@(_editCouleur ?? "#66bb6a")" @onchange="OnEditColor" />
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveEditAsync">Enregistrer</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _editId = null">Annuler</button>
                            </td>
                        }
                        else
                        {
                            <td>
                                @categorie.Nom
                                @if (systeme)
                                {
                                    <span class="badge text-bg-secondary ms-1">Système</span>
                                }
                            </td>
                            <td>
                                <span class="finance-legend-swatch" style="background:@Swatch(categorie.Couleur)"></span>
                                <code>@(categorie.Couleur ?? "auto")</code>
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_busy || systeme)" @onclick="() => StartEdit(categorie)">Modifier</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(_busy || systeme)" @onclick="() => AskDeleteAsync(categorie)">Supprimer</button>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<EditForm Model="_nouveau" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="cat-nom">Nouvelle catégorie</label>
            <InputText id="cat-nom" class="form-control form-control-sm" @bind-Value="_nouveau.Nom" />
            <ValidationMessage For="() => _nouveau.Nom" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="cat-couleur">Couleur</label>
            <input id="cat-couleur" type="color" class="form-control form-control-color form-control-sm" value="@_nouveau.Couleur" @onchange="OnNewColor" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@_busy">Ajouter</button>
        </div>
    </div>
</EditForm>

@code {
    private bool _busy;
    private string? _error;
    private List<Categorie> _categories = [];
    private int? _editId;
    private string _editNom = string.Empty;
    private string? _editCouleur;
    private CategorieForm _nouveau = new();
    private PendingDelete? _pendingDelete;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _categories = await Finance.ListerCategoriesAsync();

    private static bool IsSysteme(string nom) =>
        string.Equals(nom, FinanceService.CategorieVirementInterne, StringComparison.Ordinal)
        || string.Equals(nom, FinanceService.CategorieNonCategorise, StringComparison.Ordinal);

    private static string Swatch(string? couleur) =>
        string.IsNullOrWhiteSpace(couleur) ? "#6c757d" : couleur;

    private void OnNewColor(ChangeEventArgs e) =>
        _nouveau.Couleur = e.Value?.ToString() ?? "#66bb6a";

    private void OnEditColor(ChangeEventArgs e) =>
        _editCouleur = e.Value?.ToString();

    private void StartEdit(Categorie categorie)
    {
        _editId = categorie.Id;
        _editNom = categorie.Nom;
        _editCouleur = string.IsNullOrWhiteSpace(categorie.Couleur) ? "#66bb6a" : categorie.Couleur;
        _error = null;
        _pendingDelete = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editId is not int id)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Finance.ModifierCategorieAsync(id, _editNom, _editCouleur);
            _editId = null;
        });
    }

    private async Task AskDeleteAsync(Categorie categorie)
    {
        _error = null;
        _busy = true;
        try
        {
            var count = await Finance.CompterTransactionsParCategorieAsync(categorie.Id);
            _pendingDelete = new PendingDelete(categorie.Id, categorie.Nom, count);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmDeleteEmptyAsync()
    {
        if (_pendingDelete is null)
        {
            return;
        }

        var id = _pendingDelete.Id;
        await RunAsync(async () =>
        {
            await Finance.SupprimerCategorieAsync(id);
            _pendingDelete = null;
        });
    }

    private async Task ConfirmReassignAndDeleteAsync()
    {
        if (_pendingDelete is null)
        {
            return;
        }

        var id = _pendingDelete.Id;
        await RunAsync(async () =>
        {
            await Finance.ReassignerEtSupprimerCategorieAsync(id);
            _pendingDelete = null;
        });
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            await Finance.AjouterCategorieAsync(_nouveau.Nom, _nouveau.Couleur);
            _nouveau = new CategorieForm();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record PendingDelete(int Id, string Nom, int NombreTransactions);

    private sealed class CategorieForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le nom est obligatoire.")]
        [System.ComponentModel.DataAnnotations.MaxLength(128, ErrorMessage = "Le nom ne peut pas dépasser 128 caractères.")]
        public string Nom { get; set; } = string.Empty;

        public string Couleur { get; set; } = "#66bb6a";
    }
}
